# ============================================================================
# MyFriend POS — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it's already in .gitignore.
#
# Values below are placeholders. Real values come from:
#   - Supabase project → Settings → API
#   - Railway project → Variables tab
#   - Vercel project → Settings → Environment Variables
# ============================================================================

# --- Supabase (shared by API, worker, and all web apps) --------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-auth-settings

# --- Database (direct connection, used by Drizzle migrations) --------------
DATABASE_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# --- API (apps/api) ---------------------------------------------------------
API_PORT=3001
API_LOG_LEVEL=debug
NODE_ENV=development

# --- Worker (apps/worker) ---------------------------------------------------
WORKER_LOG_LEVEL=debug

# --- Frontend apps (apps/pwa, web-business, web-platform, web-customer) ----
# Vite only exposes variables prefixed with VITE_ to client-side code.
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Sentry (error tracking, per ADR-006) -----------------------------------
SENTRY_DSN=https://xxxxxxxxxxxxxxxx@xxxxxxx.ingest.sentry.io/xxxxxxx
SENTRY_ENVIRONMENT=development

# --- Payment providers (per ADR — DL-116, added when live in M3+) ----------
# Left blank intentionally until the pilot payment integration begins.
MPESA_API_KEY=
AIRTEL_MONEY_API_KEY=
ORANGE_MONEY_API_KEY=
