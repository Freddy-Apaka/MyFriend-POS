{
  "name": "@myfriend-pos/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared API request/response types, enums, and error codes — the single source of truth for the contract between the backend and all MyFriend POS clients",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./enums": "./src/enums/index.ts",
    "./errors": "./src/errors/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@myfriend-pos/config": "workspace:*",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
